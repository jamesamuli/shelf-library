# Copy to .env and fill in. Never commit the filled-in file.

# Signs session cookies. Generate with: openssl rand -base64 32
# Changing it invalidates every active session.
AUTH_SECRET=

# PostgreSQL connection string, written by `prisma postgres link`.
# Required at BUILD time as well as runtime: prisma.config.ts resolves it
# eagerly, so `prisma generate` fails without it — on Vercel, set it for the
# Build environment too, or the build dies with "Failed to load config file".
DATABASE_URL=

# Google sign-in for readers. Optional: the "Se connecter avec Google" button
# only appears once both are set. Create them in the Google Cloud console:
# APIs & Services → Credentials → Create credentials → OAuth client ID →
# "Web application", with these Authorized redirect URIs:
#   http://localhost:3000/login/google/callback
#   https://<production domain>/login/google/callback
# On the OAuth consent screen, pick "Internal" if the project belongs to the
# efbujumbura.com Workspace: Google then turns away outside accounts itself,
# on top of the app's own domain check.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cataloguing assistant (docs/18-author-enrichment.md). Optional: without a
# key, the "(IA)" buttons do not appear and the rest works as before. Create
# the key in Google AI Studio; billing must be enabled on its project.
GEMINI_API_KEY=
# Cheapest adequate model; change only if Google retires it.
GEMINI_MODEL=gemini-3.5-flash-lite
# Paid requests per day, all staff together. Cached answers do not count.
GEMINI_DAILY_LIMIT=30
