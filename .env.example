# Copy to .env and fill in. Never commit the filled-in file.

# Signs session cookies. Generate with: openssl rand -base64 32
# Changing it invalidates every active session.
AUTH_SECRET=

# PostgreSQL connection string, written by `prisma postgres link`.
# Required at BUILD time as well as runtime: prisma.config.ts resolves it
# eagerly, so `prisma generate` fails without it — on Vercel, set it for the
# Build environment too, or the build dies with "Failed to load config file".
DATABASE_URL=
